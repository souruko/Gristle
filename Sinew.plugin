<Plugin>
	<Information>
		<Name>Sinew</Name>
		<Author>Souru</Author>
		<Version>1.2.0</Version>
		<Description>Replacement morale and power bars for the player and the current target. Pair with the NoVitals skin, which hides the stock frames but keeps the effect icons.</Description>
